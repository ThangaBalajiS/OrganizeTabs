{
    "name": "Infinite Tabs Manager",
    "version": "0.2.9.7",
    "description": "Makes your Chrome faster and efficient",
    "permissions": ["tabs","activeTab","storage"],
    "action": {
      "default_popup": "popup.html"
      },
    "icons": {
        "16": "assets/icon24.png",
        "32": "assets/icon32.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
    },
    "default_locale" : "en",
    "manifest_version": 3
  }
